{
  "version": "champion_refresh_policy_v1",
  "cadence": {
    "full_retrain_cron": "0 7 * * MON",
    "calibration_only_cron": "0 7 * * THU",
    "drift_check_cron": "0 */6 * * *"
  },
  "windows": {
    "training_lookback_days": 720,
    "calibration_lookback_days": 90,
    "holdout_days": 30,
    "minimum_new_games_to_retrain": 120
  },
  "promotion_gates": {
    "max_allowed_mae_regression_pct": 3.0,
    "max_allowed_ece": 0.04,
    "minimum_fold_count": 6,
    "require_significance_if_close": true,
    "close_threshold_mae_pct": 1.0
  },
  "drift_triggers": {
    "psi_feature_threshold": 0.2,
    "rolling_mae_degradation_pct": 5.0,
    "calibration_coverage_deviation_pct": 5.0
  },
  "rollout": {
    "shadow_days": 14,
    "canary_traffic_pct": 25,
    "auto_rollback": true
  },
  "states": {
    "pregame": {
      "dataset": "data/processed/pregame_team_v2.parquet",
      "leaderboard": "reports/champion_runs/latest/pregame_leaderboard.csv"
    },
    "halftime": {
      "dataset": "data/processed/halftime_with_temporal_features_total.parquet",
      "leaderboard": "reports/champion_runs/latest/halftime_leaderboard.csv"
    },
    "q3": {
      "dataset": "data/processed/q3_team_v2.parquet",
      "leaderboard": "reports/champion_runs/latest/q3_leaderboard.csv"
    }
  }
}
