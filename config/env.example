# PerryPicks v4 - Social Media Automation Configuration

# Required: Odds API Key
# Get your key from: https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# Required: Discord Webhook URL
# Get this from: Discord Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Social Media Platforms

# Twitter/X API Credentials (Optional)
# Get from: https://developer.twitter.com/
TWITTER_CONSUMER_KEY=your_consumer_key_here
TWITTER_CONSUMER_SECRET=your_consumer_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here
# Alternatively, use Bearer Token (OAuth 2.0)
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Bluesky API Credentials (Optional)
# Get from: https://bsky.app/ → Settings → App Passwords → Create App Password
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=your_app_password_here

# Optional: Poll interval in seconds (default: 60)
# How often to check for triggers (recommended: 30-120 seconds)
POLL_INTERVAL=60

# Optional: Timezone (default: America/Chicago)
TZ=America/Chicago

# Optional: dedicated webhook for nightly report delivery
# Falls back to DISCORD_WEBHOOK_URL if unset
REPORTS_DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_REPORT_WEBHOOK_ID/YOUR_REPORT_WEBHOOK_TOKEN

# Optional: Discord Bot Token (for editing/replying to messages)
# Get this from: Discord Developer Portal → Create Application → Bot → Token
# If you don't have this, system will still work with webhook-only mode
# DISCORD_BOT_TOKEN=your_bot_token_here

# Optional: hard override automation DB path
AUTOMATION_DB_PATH=data/automation.db

# Optional: enable delivery from nightly runner (0/1)
DELIVER_REPORTS=0

# Optional: Social Media Platform Selection
# Set to 'twitter', 'bluesky', 'discord', or combination
# If unset, will post to all configured platforms
# SOCIAL_MEDIA_PLATFORMS=twitter bluesky discord

# Optional: Automation DB path (for post queue)
POST_QUEUE_PATH=data/post_queue.json

# Optional: Deduplication window in hours (default: 24)
# Posts for same game/trigger within this window are considered duplicates
POST_DEDUPE_WINDOW_HOURS=24
