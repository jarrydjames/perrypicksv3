# PerryPicks v4 - Discord Automation Configuration

# Required: Odds API Key
# Get your key from: https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# Required: Discord Webhook URL
# Get this from: Discord Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional: Discord Bot Token (for editing/replying to messages)
# Get this from: Discord Developer Portal → Create Application → Bot → Token
# If you don't have this, system will still work with webhook-only mode
# DISCORD_BOT_TOKEN=your_bot_token_here

# Optional: Poll interval in seconds (default: 60)
# How often to check for triggers (recommended: 30-120 seconds)
POLL_INTERVAL=60

# Optional: Timezone (default: America/Chicago)
TZ=America/Chicago

# Optional: dedicated webhook for nightly report delivery
# Falls back to DISCORD_WEBHOOK_URL if unset
REPORTS_DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_REPORT_WEBHOOK_ID/YOUR_REPORT_WEBHOOK_TOKEN

# Optional: hard override automation DB path
AUTOMATION_DB_PATH=data/automation.db

# Optional: enable delivery from nightly runner (0/1)
DELIVER_REPORTS=0

# Optional: S3 delivery target for nightly reports
# Requires boto3 + AWS credentials in runtime
REPORTS_S3_BUCKET=your-report-bucket
REPORTS_S3_PREFIX=perrypicksv3/nightly
