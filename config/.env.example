# PerryPicks v4 Automation System - Configuration
# Copy this file to .env and fill in your values

# Odds API Configuration
# Get your API key from https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# Discord Configuration
# Create a Discord webhook: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# Optional: Discord Bot Token (for editing/replying to messages)
# If not provided, will use webhook-only mode
DISCORD_BOT_TOKEN=your_bot_token_here

# Database Configuration
# Path to SQLite database (default: data/automation.db)
DB_PATH=data/automation.db

# Automation Configuration
# Poll interval in seconds (default: 60)
POLL_INTERVAL=60

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# NBA API Configuration
# Season to use (default: 2025-26)
NBA_SEASON=2025-26
